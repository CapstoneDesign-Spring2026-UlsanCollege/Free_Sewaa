rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participantIds;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if isOwner(userId);
      allow delete: if false;
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /requests/{requestId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.requesterId;
      allow read, update: if signedIn() &&
        (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.ownerId);
      allow delete: if signedIn() &&
        (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.ownerId);
    }

    match /conversations/{conversationId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow read, update: if isParticipant(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if isOwner(resource.data.userId);
    }

    match /appStates/{userId} {
      allow create, read, update: if isOwner(userId);
      allow delete: if false;
    }
  }
}

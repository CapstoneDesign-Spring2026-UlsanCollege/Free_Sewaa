# Environment Variables Example
# Copy this file to .env and fill in your values

# MongoDB Connection (required)
# Render should use MONGODB_URI from MongoDB Atlas.
# Local development can use MONGO_URI if you run MongoDB locally.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/freesewaa
MONGO_URI=mongodb://localhost:27017/freesewaa

# Server Configuration
PORT=3000
NODE_ENV=development
DB_NAME=freesewaa
FIREBASE_PROJECT_ID=free-sewaa
FIREBASE_PROJECT_NUMBER=751406321487
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=free-sewaa.firebaseapp.com
FIREBASE_STORAGE_BUCKET=free-sewaa.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Session Secret (change this!)
SESSION_SECRET=your-super-secret-session-key-change-this

# Admin Credentials (optional - defaults exist)
# ADMIN_EMAIL=admin@freesewaa.local
# ADMIN_PASSWORD=admin12345

# Super admin bootstrap
# Comma-separated emails or user IDs that should be promoted to superadmin on startup.
# Only superadmins can block/delete users or change admin roles.
SUPER_ADMIN_EMAILS=your-email@example.com
# SUPER_ADMIN_USER_IDS=user-123

# Application URL
APP_URL=http://localhost:3000
# Render example:
# APP_URL=https://free-sewaa-qh05.onrender.com
